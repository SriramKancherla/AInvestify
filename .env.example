# Copy to .env and fill in values. .env is gitignored — never commit real secrets.
# For basic local dev the defaults below are fine; set GEMINI_* and SUPABASE_* to
# enable the Gemini chatbot and auth-gated features (portfolio, watchlists, sync, export).

# --- Chatbot (Gemini) ---
GEMINI_API_KEY=
GEMINI_TIMEOUT_SECONDS=12
CHAT_STYLE_REWRITE=false
CHAT_STYLE_PROVIDER=gemini

# --- App / security ---
APP_ENV=development
FRONTEND_DIR=frontend-2
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ORIGINS=http://localhost:8000
ENABLE_PROXY_HEADERS=false
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization

# --- Reliability / rate limits ---
RATE_LIMIT_INSIGHTS_COUNT=60
RATE_LIMIT_INSIGHTS_WINDOW_SECONDS=60
RATE_LIMIT_CHATBOT_COUNT=30
RATE_LIMIT_CHATBOT_WINDOW_SECONDS=60
RATE_LIMIT_UNSTICK_EMAIL_COUNT=8
RATE_LIMIT_UNSTICK_EMAIL_WINDOW_SECONDS=3600
INSIGHTS_CACHE_TTL_SECONDS=8
HTTP_RETRY_COUNT=2
HTTP_RETRY_BACKOFF_MS=300
DEBUG_INSIGHTS_CALLS=false

# --- Supabase (auth, portfolio, watchlists, report export, sync) ---
# Server-side. If SUPABASE_SERVICE_ROLE_KEY is unset, the backend uses in-memory dev stores.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Optional; defaults to {SUPABASE_URL}/auth/v1
# SUPABASE_JWT_ISSUER=
# Tests only — skips JWT signature verification. Never set in production.
# AUTH_JWT_INSECURE_SKIP_VERIFY=

# Browser client (build-time, injected into the SPA — set as Docker build args in prod).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
